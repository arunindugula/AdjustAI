# ClaimSense AI — local / deploy-time secrets
# ============================================
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# Model override — gpt-4o-mini for dev, gpt-4o for prod
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# AWS deploy targets (filled in after `sam deploy`)
# ---------------------------------------------------------------------------
USER_POOL_ID=us-east-1_XXXXXXXXX
USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
KNOWLEDGE_BASE_ID=XXXXXXXXXXXXXXXXXX
DOCS_BUCKET=claimsense-docs-XXXXXXXXXXXX

# ---------------------------------------------------------------------------
# Cognito seed accounts
# Password used by seed_cognito.py — must match the pool's PasswordPolicy
# (12+ chars, upper, lower, digit, no symbols required)
# ---------------------------------------------------------------------------
COGNITO_SEED_PASSWORD=AutoSure2024!

# Accounts created by `make cognito`:
